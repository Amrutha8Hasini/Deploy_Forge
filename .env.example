# Copy this file to .env and change the values:  cp .env.example .env

# Login for the DeployForge dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Used to sign login tokens. Use any long random text.
SECRET_KEY=change-this-to-a-long-random-string

# Optional: GitHub Personal Access Token used for private repositories
# (fine-grained token with read-only "Contents" permission)
GITHUB_TOKEN=

# Host ports given to deployed applications
APP_PORT_START=8100
APP_PORT_END=8199

# Resource limits for each deployed application container
APP_MEMORY_LIMIT=256m
APP_CPU_LIMIT=0.5

# Used only by docker-compose.prod.yml / deploy workflow (GitHub Container Registry)
GHCR_OWNER=your-github-username-in-lowercase
IMAGE_TAG=latest
